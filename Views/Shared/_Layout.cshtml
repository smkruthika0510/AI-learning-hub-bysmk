@{
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
    bool onUpload = action is "index" or "processvideo";
    bool onHistory = action is "history" or "viewvideo" or "submitquiz";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - AI Learning Hub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">

        <header class="mobilebar">
            <button type="button" class="menu-btn" id="menuBtn" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
            <a class="brand" asp-controller="Video" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                <span class="brand-name">AI Learning Hub</span>
            </a>
        </header>

        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Video" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                <span class="brand-name">
                    AI Learning Hub
                    <span class="brand-sub">Lecture study workspace</span>
                </span>
            </a>

            <nav aria-label="Main">
                <ul class="side-nav">
                    <li>
                        <a asp-controller="Video" asp-action="Index" class="@(onUpload ? "active" : "")" aria-current="@(onUpload ? "page" : null)">
                            <i class="bi bi-cloud-arrow-up"></i> New lecture
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Video" asp-action="History" class="@(onHistory ? "active" : "")" aria-current="@(onHistory ? "page" : null)">
                            <i class="bi bi-collection-play"></i> My lectures
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="side-foot">
                Built at AarGees Business Solutions
            </div>
        </aside>

        <div class="scrim" id="scrim"></div>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (function() {
                var btn = document.getElementById('menuBtn');
                var side = document.getElementById('sidebar');
                var scrim = document.getElementById('scrim');

                function setOpen(open) {
                    side.classList.toggle('open', open);
                    scrim.classList.toggle('show', open);
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                }

                btn.addEventListener('click', function() { setOpen(!side.classList.contains('open')); });
                scrim.addEventListener('click', function() { setOpen(false); });
                document.addEventListener('keydown', function(e) { if (e.key === 'Escape') setOpen(false); });
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>